# ==============================================================================
# NodeBase AI Workflow Builder - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Do not commit real secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (Runtime Requirement)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string (used by Prisma).
# Build-time: Not required for `next build` or `prisma generate`.
# Runtime: Required for user auth, workflows, credentials, and executions.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nodebase?schema=public"

# ------------------------------------------------------------------------------
# 2. Credential Encryption (Runtime Requirement)
# ------------------------------------------------------------------------------
# Secret key used by Cryptr to encrypt/decrypt stored API keys in the database.
# Build-time: Not required (evaluated lazily at runtime).
# Runtime: Required when saving or executing AI nodes with credentials.
ENCRYPTION_KEY="replace_with_a_secure_random_string_at_least_32_chars"

# ------------------------------------------------------------------------------
# 3. Authentication - Better Auth (Runtime Requirement)
# ------------------------------------------------------------------------------
# Secret for signing session cookies and tokens.
BETTER_AUTH_SECRET="replace_with_a_secure_random_session_secret"

# Canonical application URL used for auth callbacks and sessions.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. OAuth Providers (Optional / Runtime Requirement for Social Login)
# ------------------------------------------------------------------------------
# Required only if logging in with GitHub or Google OAuth.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 5. Billing & Subscriptions - Polar (Runtime Requirement for Pro Tier)
# ------------------------------------------------------------------------------
# Polar organization access token (sandbox or production).
POLAR_ACCESS_TOKEN=""
POLAR_SUCCESS_URL="http://localhost:3000/workflows"

# ------------------------------------------------------------------------------
# 6. Webhooks (Runtime Requirement for External Triggers)
# ------------------------------------------------------------------------------
# Stripe webhook signing secret (from Stripe Dashboard or CLI)
STRIPE_WEBHOOK_SECRET=""

# Google Form webhook shared secret token (optional, for authenticating submissions)
GOOGLE_FORM_WEBHOOK_SECRET=""
